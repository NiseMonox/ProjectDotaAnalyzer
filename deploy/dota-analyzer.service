[Unit]
Description=Dota 2 Match Analyzer (FastAPI + uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/dota-analyzer
# All app settings (DEEPSEEK_API_KEY, ADMIN_TOKEN, rate limits, ...) live in
# .env — see .env.example. The app also reads this file itself.
EnvironmentFile=/opt/dota-analyzer/.env
Environment=PYTHONUNBUFFERED=1
# Single worker on purpose: rate limits, caches and in-flight de-duplication
# are per process. Behind nginx, switch --host to 127.0.0.1 (see README).
# --timeout-graceful-shutdown stops open SSE streams from delaying restarts.
ExecStart=/opt/dota-analyzer/backend/venv/bin/uvicorn backend.app.main:app \
    --host 0.0.0.0 --port 8001 --workers 1 --timeout-graceful-shutdown 15
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

# Lightweight hardening (tighten further once under load)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/dota-analyzer

[Install]
WantedBy=multi-user.target
