# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.
# Every variable is optional. Commented lines show the default; uncomment to
# change one. Real environment variables (e.g. systemd Environment=) override
# .env. Relative paths are relative to the project root.

# ---------------------------------------------------------------------------
# AI coach (LLM)
# ---------------------------------------------------------------------------
# DeepSeek (OpenAI-compatible) API key. Leave blank for rule-based reports only.
DEEPSEEK_API_KEY=
# API base URL.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model used for coaching evaluations.
# AI_COACH_MODEL=deepseek-v4-flash
# Tool-calling agent for decision evaluation (0 disables).
# AI_COACH_AGENT=1
# Model for the agent (blank = AI_COACH_MODEL).
# AI_COACH_AGENT_MODEL=
# Max tool-calling steps per agent run.
# AI_COACH_AGENT_MAX_STEPS=6
# Parallel LLM calls per report.
# AI_COACH_MAX_CONCURRENCY=4
# Overall deadline (seconds) for one report; the server waits 60 s longer before giving up.
# AI_COACH_TIMEOUT_S=180
# Max cold LLM-backed reports per UTC day across all users (0 = unlimited). Cached reports are free.
# AI_COACH_DAILY_LIMIT=200
# Seconds a degraded report (LLM failed, rules used) stays cached in memory; never written to disk.
# AI_COACH_DEGRADED_TTL_S=600
# Max AI coach report files kept in cache/coaching/.
# COACH_CACHE_MAX_FILES=2000

# ---------------------------------------------------------------------------
# Startup maintenance (runs in the background, never blocks startup)
# ---------------------------------------------------------------------------
# Refresh game data from OpenDota when missing, on a new patch or when stale (0 disables).
# GAMEDATA_AUTO_UPDATE=1
# Game data older than this many days is refreshed.
# GAMEDATA_STALE_DAYS=7
# Run the AI coach self-learning pipeline when due, after the game data step (0 disables).
# AI_COACH_AUTO_LEARN=1
# Netscape cookies.txt exported from a logged-in browser, for Bilibili subtitles
# (default: backend/data/bilibili_cookies.txt if present). Keep it secret.
# BILIBILI_COOKIES_FILE=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Bind address / port for run.sh and `python -m backend.app.main`.
# HOST=0.0.0.0
# PORT=8000
# 1 = uvicorn auto-reload (development only).
# DEV=0
# Python used by run.sh to create backend/venv (read from the environment only).
# PYTHON=python3
# Log level for the app's own loggers (DEBUG, INFO, WARNING, ...).
# LOG_LEVEL=INFO
# Comma-separated CORS origin allowlist. Empty = no CORS (frontend is same-origin).
# ALLOWED_ORIGINS=
# 1 = take the client IP from X-Real-IP / X-Forwarded-For. Only behind a proxy
# you control (nginx) with uvicorn bound to 127.0.0.1, otherwise IPs can be spoofed.
# TRUST_PROXY_HEADERS=0
# Secret for /api/admin/* and /api/parse-local/* (send it as the X-Admin-Token
# header). Empty = those endpoints always return 403. e.g. `openssl rand -hex 32`.
ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Per-client-IP rate limits: "count/seconds" (sliding window); 0 or off disables.
# Exceeding one returns HTTP 429 with a Retry-After header.
# ---------------------------------------------------------------------------
# RATE_LIMIT_UPLOAD=10/3600
# Only cache misses count (OpenDota fetches).
# RATE_LIMIT_FETCH=30/600
# RATE_LIMIT_REQUEST_PARSE=10/600
# Only cold report generations count.
# RATE_LIMIT_AI_COACH=10/3600

# ---------------------------------------------------------------------------
# Uploads and storage
# ---------------------------------------------------------------------------
# Max replay upload size in MB (HTTP 413 beyond it).
# MAX_UPLOAD_MB=300
# Uploads received at the same time (more get HTTP 503).
# UPLOAD_MAX_CONCURRENCY=3
# Uploaded replays kept in replays/ (content-hash named; oldest deleted first).
# REPLAY_MAX_FILES=50
# Parsed matches persisted in cache/matches/ (survive restarts).
# MATCH_CACHE_MAX_FILES=200
# Parsed matches kept in memory.
# MATCH_MEMORY_CACHE_SIZE=12
# Seconds before an OpenDota match without parsed data is fetched again.
# OPENDOTA_UNPARSED_TTL_S=120

# ---------------------------------------------------------------------------
# Replay parser (Clarity, Java 17+)
# ---------------------------------------------------------------------------
# Java executable. Default: tools/jdk17 (macOS or Linux layout), then $JAVA_HOME/bin/java, then `java` on PATH.
# JAVA_PATH=
# Parser jar (rebuild with: bash tools/setup_parser.sh).
# CLARITY_JAR_PATH=tools/clarity-analyzer.jar
# Replays parsed at the same time (each JVM uses up to CLARITY_JVM_XMX of RAM).
# CLARITY_MAX_CONCURRENCY=1
# JVM max heap per parse.
# CLARITY_JVM_XMX=1536m
# Seconds before a parse is killed.
# CLARITY_TIMEOUT_S=300
