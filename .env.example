# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.
# Every variable is optional. Commented lines show the default; uncomment to
# change one. Real environment variables (e.g. systemd Environment=) override
# .env. Relative paths are relative to the project root.

# ---------------------------------------------------------------------------
# AI coach (LLM)
# ---------------------------------------------------------------------------
# DeepSeek (OpenAI-compatible) API key. Leave blank for rule-based reports only.
DEEPSEEK_API_KEY=
# API base URL.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model used for coaching evaluations and by the learning pipeline (the name
# the endpoint's /models lists). One report with an LLM is 14-31 requests,
# about 105-130k prompt tokens and 38-60k completion tokens, 60-85 s
# (measured with this model on 2026-10-11).
# AI_COACH_MODEL=deepseek-flash
# Tool-calling agent for decision evaluation (0 disables).
# AI_COACH_AGENT=1
# Model for the agent (blank = AI_COACH_MODEL).
# AI_COACH_AGENT_MODEL=
# Max tool-calling steps per agent run.
# AI_COACH_AGENT_MAX_STEPS=6
# max_tokens of one decision evaluation and of one phase review (each 512-16384;
# values outside are clamped). The model's hidden reasoning is billed inside
# this budget; an answer cut off by it is asked for once more without reasoning.
# AI_COACH_MAX_TOKENS=8192
# AI_COACH_PHASE_MAX_TOKENS=4096
# Parallel LLM requests for the whole server process (shared by all reports
# being generated at the same time).
# AI_COACH_MAX_CONCURRENCY=4
# Overall deadline (seconds) for one report; the server waits 60 s longer before giving up.
# AI_COACH_TIMEOUT_S=180
# Max cold LLM-backed reports per UTC day across all users (0 = unlimited). Cached reports are free.
# AI_COACH_DAILY_LIMIT=200
# Seconds a degraded report (LLM failed, rules used) stays cached in memory; never written to disk.
# AI_COACH_DEGRADED_TTL_S=600
# Max AI coach report files kept in cache/coaching/.
# COACH_CACHE_MAX_FILES=2000
# Reports written without an API key (rule-based) are cached separately and
# are no longer served once DEEPSEEK_API_KEY is set.

# ---------------------------------------------------------------------------
# Background maintenance (never blocks startup or shutdown)
# ---------------------------------------------------------------------------
# Refresh game data (heroes, abilities, items, patch tables) when missing, when
# a new game version or data revision is out, or when stale (0 disables). Read
# from the dotaconstants master branch on GitHub, then its jsDelivr mirror,
# then the OpenDota API; the game version comes from Valve's patch feed.
# GAMEDATA_AUTO_UPDATE=1
# Hours between repetitions of that check while the server runs, so a patch
# released after the start is picked up without a restart (0 = only at startup;
# anything between 0 and 0.25 counts as 0.25: every check asks GitHub's API).
# A start within 15 minutes of the last check does not check again.
# GAMEDATA_RECHECK_HOURS=24
# Game data older than this many days is refreshed (and reported as stale by
# /api/admin/gamedata-status). An uploaded replay played later than this many
# days after the last refresh gets no patch label.
# GAMEDATA_STALE_DAYS=7
# Run the AI coach self-learning pipeline when due, after the game data step (0 disables).
# Also checked again after a periodic game-data check brought new data.
# A run still in progress is stopped when the server stops (it never delays a
# restart); what it did not finish is due again on the next start (level 1
# continues after the heroes it had finished). Never started with DEV=1, where
# every reload would restart it: run `python -m backend.scripts.learn` then.
# AI_COACH_AUTO_LEARN=1
# Netscape cookies.txt exported from a logged-in browser, for Bilibili subtitles
# (default: backend/data/learned/bilibili_cookies.txt if present). Keep it secret.
# Only used by learning level 4, which also needs yt-dlp on the PATH (optional,
# not in requirements.txt; the level is skipped without it).
# BILIBILI_COOKIES_FILE=
# OpenDota API key (optional): higher OpenDota rate limits for match fetches,
# parse requests and the learning pipeline. Sent as api_key on every OpenDota call.
# OPENDOTA_API_KEY=

# ---------------------------------------------------------------------------
# Knowledge retrieval for the AI coach (RAG)
# ---------------------------------------------------------------------------
# The coach's reference knowledge is ranked by tags + BM25 ("lexical") and,
# when vectors exist, additionally by embedding similarity ("hybrid"). The
# committed vector file backend/data/rag/<model>.npz covers the built-in and
# editorial knowledge and needs numpy only: no model, no download, nothing to
# configure. An embedder is only needed for knowledge that changes at runtime
# (self-learned chunks, texts changed by a game-data update) and for the
# agent's free-text search. See deploy/README.md ("Knowledge retrieval").
#
# auto   = an OpenAI-compatible embeddings API if RAG_EMBED_API_* is set, else
#          the local ONNX model if its packages and files are there, else
#          only the prebuilt vectors
# off    = lexical ranking only (the vector files are not read)
# onnx   = local model only; openai = API only; hash = tests only
# RAG_EMBEDDINGS=auto
# Local model (a key of the model registry in backend/app/ai/rag/embedders.py).
# Needs: pip install -r backend/requirements-rag.txt, then
#        python -m backend.scripts.rag download-model
# RAG_MODEL=bge-small-en-v1.5-int8
# Directory holding <model>/ (gitignored). The server never downloads a model.
# RAG_MODEL_DIR=backend/data/models
# Hugging Face endpoint used by `rag download-model` only (e.g. a mirror).
# HF_ENDPOINT=https://huggingface.co
# CPU threads of the local model, and seconds of idleness after which it is
# unloaded from memory again (0 = keep it loaded).
# RAG_EMBED_THREADS=1
# RAG_MODEL_IDLE_UNLOAD_S=900
# OpenAI-compatible /embeddings endpoint instead of a local model. Separate
# from the coach's LLM settings on purpose: DEEPSEEK_API_KEY is never used here.
# The whole knowledge base is embedded through the API once and cached in
# RAG_INDEX_DIR. Vectors of different models are never mixed: reports keep
# using the prebuilt file until the API's vectors cover the knowledge base,
# and again whenever the API cannot be reached.
# RAG_EMBED_API_BASE_URL=
# RAG_EMBED_API_KEY=
# RAG_EMBED_API_MODEL=
# Vectors built at runtime (learned knowledge); safe to delete, rebuilt when needed.
# A <model>.npz.lock file next to them keeps the server and a command-line
# build from embedding the same texts at the same time.
# RAG_INDEX_DIR=cache/rag
# Max knowledge entries per decision (0 = no cap beyond the text budget).
# RAG_TOP_K=0
# Free-text knowledge searches the tool-calling agent may run per evaluation
# (on top of the block retrieved for the decision), at most 6. 0 = no
# free-text search: the knowledge tool then only returns that block. Without an
# embedding model the search is keyword-only.
# RAG_AGENT_SEARCH_LIMIT=3
# 1 = at server start a background thread builds the knowledge stores and, with
# an embedder, the vectors that are missing; the same happens after a learning
# run or game-data update. 0 = the stores are built when the first report needs
# them and the server never embeds missing texts itself: run
# `python -m backend.scripts.rag build` by hand or from cron instead.
# RAG_WARM_UP=1

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Bind address / port for run.sh and `python -m backend.app.main`.
# HOST=0.0.0.0
# PORT=8000
# 1 = development mode: uvicorn auto-reload, the API documentation under /docs
# and /openapi.json (not served otherwise), no automatic learning runs.
# DEV=0
# Python used by run.sh to create backend/venv (read from the environment only).
# PYTHON=python3
# Log level for the app's own loggers (DEBUG, INFO, WARNING, ...).
# LOG_LEVEL=INFO
# Worker threads for blocking request work (analysis, disk, OpenDota calls, AI coach steps).
# THREADPOOL_SIZE=32
# Comma-separated CORS origin allowlist. Empty = no CORS (frontend is same-origin).
# ALLOWED_ORIGINS=
# 1 = take the client IP from X-Real-IP / X-Forwarded-For. Only behind a proxy
# you control (nginx) with uvicorn bound to 127.0.0.1, otherwise IPs can be spoofed.
# TRUST_PROXY_HEADERS=0
# Secret for /api/admin/* and /api/parse-local/* (send it as the X-Admin-Token
# header). Empty = those endpoints always return 403. e.g. `openssl rand -hex 32`.
ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Per-client-IP rate limits: "count/seconds" (sliding window); 0 or off disables,
# a blank value means the default. Exceeding one returns HTTP 429 with a
# Retry-After header.
# ---------------------------------------------------------------------------
# RATE_LIMIT_UPLOAD=10/3600
# Only cache misses count (OpenDota fetches).
# RATE_LIMIT_FETCH=30/600
# RATE_LIMIT_REQUEST_PARSE=10/600
# Only cold report generations count. The first applies while an LLM is
# configured (it guards the API budget), the second to rule-based reports,
# which cost milliseconds (one match has ten players in two languages).
# RATE_LIMIT_AI_COACH=10/3600
# RATE_LIMIT_AI_COACH_RULES=120/3600

# ---------------------------------------------------------------------------
# Uploads and storage
# ---------------------------------------------------------------------------
# Max replay size in MB (HTTP 413 beyond it). Compressed uploads (.dem.bz2 /
# .dem.zst, unpacked by the server) may be neither larger than this as sent
# nor unpack to more.
# MAX_UPLOAD_MB=300
# Uploads received at the same time (more get HTTP 503).
# UPLOAD_MAX_CONCURRENCY=3
# ... and how many of those one client IP may have in flight (more get HTTP 429).
# UPLOAD_MAX_PER_CLIENT=1
# Seconds a client has to send the whole upload body; slower uploads are dropped (HTTP 400).
# UPLOAD_RECEIVE_TIMEOUT_S=900
# ... and seconds the body may stall in between. Frees the client's upload slot
# when its connection died without closing (sleep, network change).
# UPLOAD_IDLE_TIMEOUT_S=60
# Uploaded replays kept in replays/ (content-hash named; oldest deleted first).
# REPLAY_MAX_FILES=50
# Parsed matches persisted in cache/matches/ (survive restarts).
# MATCH_CACHE_MAX_FILES=200
# Parsed matches kept in memory.
# MATCH_MEMORY_CACHE_SIZE=12
# Seconds before "fetch by match ID" downloads an OpenDota match without parsed
# data again (0 = on every fetch). The stored copy keeps being served meanwhile.
# OPENDOTA_UNPARSED_TTL_S=120

# ---------------------------------------------------------------------------
# Replay parser (Clarity, Java 17+)
# ---------------------------------------------------------------------------
# Java executable. Default: tools/jdk17 (macOS or Linux layout), then $JAVA_HOME/bin/java, then `java` on PATH.
# JAVA_PATH=
# Parser jar (committed; developers rebuild it with: REBUILD=1 bash tools/setup_parser.sh).
# CLARITY_JAR_PATH=tools/clarity-analyzer.jar
# Replays parsed at the same time (each JVM uses up to CLARITY_JVM_XMX of RAM).
# CLARITY_MAX_CONCURRENCY=1
# JVM max heap per parse.
# CLARITY_JVM_XMX=1536m
# Seconds before a parse is killed.
# CLARITY_TIMEOUT_S=300
# 1 = verbose diagnostics from the Java analyzer on its stderr. The server logs
# the end of that output for failed parses, and for every parse at LOG_LEVEL=DEBUG.
# CLARITY_DEBUG=0
